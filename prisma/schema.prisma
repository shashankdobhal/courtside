// Prisma schema for CourtSide
// PostgreSQL (Prisma Postgres, provisioned via Vercel). Enums are still modeled
// as validated strings — not for SQLite compatibility anymore, just to match
// the existing TS union types in types/index.ts and keep migrations simple.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id         String   @id @default(cuid())
  name       String
  type       String // TournamentType: ROUND_ROBIN | ROUND_ROBIN_KNOCKOUT -- meaningless for DOUBLES, which has no generated fixtures
  format     String   @default("SINGLES") // TournamentFormat: SINGLES | DOUBLES
  status     String   @default("PENDING") // TournamentStatus: PENDING | ACTIVE | COMPLETED
  legs       Int      @default(1) // how many times each pair plays in the league stage (1-3)
  joinCode   String   @unique // short human-friendly code for self-join, alternative to sharing the full link
  youtubeUrl String? // organizer-pasted YouTube video/live link, shown as an embed and on the public /live hub
  ownerId    String? // null for tournaments created before accounts existed, until claimed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  players Player[]
  matches Match[]

  @@index([ownerId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts         Account[]
  sessions         Session[]
  ownedTournaments Tournament[]
  playerProfile    PlayerProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlayerProfile {
  id           String   @id @default(cuid())
  name         String
  createdAt    DateTime @default(now())
  userId       String?  @unique // links this identity to the Google account that self-joined with it
  seasonOptIn  Boolean  @default(false) // must opt in to be counted on the leaderboard
  bio          String?
  playingStyle String?
  hometown     String?

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  players          Player[]
  partneredPlayers Player[] @relation("PlayerPartnerProfile")

  @@index([name])
}

model Player {
  id               String  @id @default(cuid())
  tournamentId     String
  name             String
  alias            String? // optional fun nickname shown in place of the real name
  profileId        String? // links to a reusable cross-tournament identity; null for legacy rows until backfilled
  partnerProfileId String? // doubles only: this Player row is a two-person team; profileId + partnerProfileId are its two members
  withdrawn        Boolean @default(false)

  tournament     Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  profile        PlayerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  partnerProfile PlayerProfile? @relation("PlayerPartnerProfile", fields: [partnerProfileId], references: [id], onDelete: SetNull)

  matchesAsPlayer1 Match[] @relation("Player1Matches")
  matchesAsPlayer2 Match[] @relation("Player2Matches")
  matchesWon       Match[] @relation("MatchWinner")

  @@index([tournamentId])
  @@index([profileId])
  @@index([partnerProfileId])
}

model Match {
  id            String    @id @default(cuid())
  tournamentId  String
  player1Id     String
  player2Id     String?
  score1        Int? // for a best-of-three match, this is games won (0-2), not points
  score2        Int?
  winnerId      String?
  round         String // e.g. "LEAGUE", "SEMI_FINAL_1", "SEMI_FINAL_2", "FINAL"
  status        String    @default("PENDING") // MatchStatus: PENDING | COMPLETED | VOID
  matchOrder    Int
  completedAt   DateTime? // set once, the first time status becomes COMPLETED; used for leaderboard bucketing
  isBestOfThree Boolean   @default(false) // knockout-round option; league matches are always single-game
  game1Score1   Int?
  game1Score2   Int?
  game2Score1   Int?
  game2Score2   Int?
  game3Score1   Int?
  game3Score2   Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    Player     @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: Cascade)
  player2    Player?    @relation("Player2Matches", fields: [player2Id], references: [id], onDelete: Cascade)
  winner     Player?    @relation("MatchWinner", fields: [winnerId], references: [id])

  @@index([tournamentId])
}
