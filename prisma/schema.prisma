// Prisma schema for CourtSide
// PostgreSQL (Prisma Postgres, provisioned via Vercel). Enums are still modeled
// as validated strings — not for SQLite compatibility anymore, just to match
// the existing TS union types in types/index.ts and keep migrations simple.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id               String    @id @default(cuid())
  name             String
  type             String // TournamentType: ROUND_ROBIN | ROUND_ROBIN_KNOCKOUT | KNOCKOUT | SESSION -- SESSION is doubles-only (ad-hoc, no generated fixtures); singles is always one of the other three
  format           String    @default("SINGLES") // TournamentFormat: SINGLES | DOUBLES
  status           String    @default("PENDING") // TournamentStatus: PENDING | ACTIVE | COMPLETED
  legs             Int       @default(1) // how many times each pair plays in the league stage (1-3)
  joinCode         String    @unique // short human-friendly code for self-join, alternative to sharing the full link
  venue            String? // e.g. "Sportyzo Academy" — shown on the invite share message alongside scheduledAt
  scheduledAt      DateTime? // when the game/tournament is happening — shown on the invite share message
  skillLevels      String[]  @default([]) // SkillLevel[]: which of BEGINNER/INTERMEDIATE/ADVANCED/PROFESSIONAL this game suits — shown on the invite share message as "Level"
  playerLimit      Int? // optional cap on confirmed roster size — self-joins/adds beyond it land on the waiting list (see Player.waitlisted)
  youtubeUrl       String? // organizer-pasted YouTube video/live link, always shown as an embed on this tournament's own page
  youtubeUrlPublic Boolean   @default(false) // opt-in: also list this stream on the public /live hub for signed-out/discovery visitors
  ownerId          String? // null for tournaments created before accounts existed, until claimed
  eventId          String? // links this category into a multi-category Event (e.g. Men's Singles under a corporate sports day); null for a standalone tournament
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner    User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  players  Player[]
  matches  Match[]
  expenses Expense[]

  @@index([ownerId])
  @@index([eventId])
}

/**
 * A lightweight umbrella grouping several Tournament rows ("categories") —
 * Men's Singles, Doubles, Mixed Doubles — under one shared name and join
 * link, for events that run more than one draw at once. Each category
 * remains a full, independent Tournament with its own roster/fixtures/
 * standings; the Event just clusters them for a shared hub page.
 */
model Event {
  id        String   @id @default(cuid())
  name      String
  joinCode  String   @unique
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tournaments Tournament[]

  @@index([ownerId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  ownedTournaments  Tournament[]
  ownedEvents       Event[]
  playerProfile     PlayerProfile?
  pushSubscriptions PushSubscription[]
}

/**
 * A standalone stream not tied to any CourtSide tournament — e.g. coverage
 * of an external event — added directly by the super admin and shown on
 * /live alongside tournament streams. isLive is a manual toggle (no
 * automatic detection of whether the YouTube broadcast is still live).
 */
model Livestream {
  id         String   @id @default(cuid())
  title      String
  youtubeUrl String
  isLive     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isLive])
}

/**
 * One browser/device's Web Push subscription for a signed-in user — a
 * user can have several (phone, laptop, ...), each notified independently.
 * endpoint doubles as the natural per-device identity: re-subscribing the
 * same device upserts the same row rather than duplicating it.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlayerProfile {
  id           String   @id @default(cuid())
  name         String
  createdAt    DateTime @default(now())
  userId       String?  @unique // links this identity to the Google account that self-joined with it
  seasonOptIn  Boolean  @default(true) // counted on the leaderboard by default — a player can opt out from their own profile
  bio          String?
  playingStyle String?
  hometown     String?
  company      String? // e.g. employer/team name, shown on the roster for corporate tournaments
  upiId        String? // UPI VPA (e.g. name@bank), used to build "Pay" links on the expense settle-up list

  isCoach              Boolean @default(false) // opts this profile into the /coaches directory
  coachYearsExperience Int?
  coachSkills          String? // free text, e.g. "Footwork, doubles strategy, juniors"
  coachAvailability    String? // free text, e.g. "Weekday evenings, weekend mornings"

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  players          Player[]
  partneredPlayers Player[] @relation("PlayerPartnerProfile")

  followers                Follow[]              @relation("ProfileFollowers")
  following                Follow[]              @relation("ProfileFollowing")
  coachingRequestsReceived CoachingRequest[]     @relation("CoachingRequestsReceived")
  coachingRequestsSent     CoachingRequest[]     @relation("CoachingRequestsSent")
  learnPosts               LearnPost[]
  communityMemberships     CommunityMembership[]

  @@index([name])
}

/**
 * One signed-in player following another — originally coach-only, now open
 * to any profile. Lightweight, no notification of its own (unlike
 * CoachingRequest below).
 */
model Follow {
  id                String   @id @default(cuid())
  followedProfileId String
  followerProfileId String
  createdAt         DateTime @default(now())

  followedProfile PlayerProfile @relation("ProfileFollowers", fields: [followedProfileId], references: [id], onDelete: Cascade)
  followerProfile PlayerProfile @relation("ProfileFollowing", fields: [followerProfileId], references: [id], onDelete: Cascade)

  @@unique([followedProfileId, followerProfileId])
  @@index([followedProfileId])
  @@index([followerProfileId])
}

/**
 * A short public post a player adds to their own profile — a text note
 * and/or a YouTube/Facebook video link, shown with their name in the
 * Explore "Learn" tab. Not tournament content; purely player-authored.
 */
model LearnPost {
  id              String   @id @default(cuid())
  title           String
  body            String? // text note
  videoUrl        String? // YouTube or Facebook video link
  authorProfileId String
  createdAt       DateTime @default(now())

  author PlayerProfile @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)

  @@index([authorProfileId])
  @@index([createdAt])
}

/**
 * A direct ask to book a session — pushes a notification to the coach.
 * requesterProfileId is null for a signed-out visitor, who types their name
 * in instead; requesterName is always set either way, so the coach's inbox
 * never needs a join to show who's asking.
 */
model CoachingRequest {
  id                 String   @id @default(cuid())
  coachProfileId     String
  requesterProfileId String?
  requesterName      String
  requesterPhone     String
  createdAt          DateTime @default(now())

  coachProfile     PlayerProfile  @relation("CoachingRequestsReceived", fields: [coachProfileId], references: [id], onDelete: Cascade)
  requesterProfile PlayerProfile? @relation("CoachingRequestsSent", fields: [requesterProfileId], references: [id], onDelete: SetNull)

  @@index([coachProfileId])
  @@index([requesterProfileId])
}

model Player {
  id               String   @id @default(cuid())
  tournamentId     String
  name             String
  alias            String? // optional fun nickname shown in place of the real name
  profileId        String? // links to a reusable cross-tournament identity; null for legacy rows until backfilled
  partnerProfileId String? // doubles only: this Player row is a two-person team; profileId + partnerProfileId are its two members
  withdrawn        Boolean  @default(false)
  waitlisted       Boolean  @default(false) // past the tournament's playerLimit at join time — shown separately, excluded from fixture generation
  createdAt        DateTime @default(now()) // join order — decides who's promoted first when a waitlist spot opens up

  tournament     Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  profile        PlayerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  partnerProfile PlayerProfile? @relation("PlayerPartnerProfile", fields: [partnerProfileId], references: [id], onDelete: SetNull)

  matchesAsPlayer1 Match[] @relation("Player1Matches")
  matchesAsPlayer2 Match[] @relation("Player2Matches")
  matchesWon       Match[] @relation("MatchWinner")

  expensesPaid          Expense[]            @relation("ExpensePaidBy")
  expenseParticipations ExpenseParticipant[] @relation("ExpenseParticipant")

  @@index([tournamentId])
  @@index([profileId])
  @@index([partnerProfileId])
}

model Match {
  id            String    @id @default(cuid())
  tournamentId  String
  player1Id     String
  player2Id     String?
  score1        Int? // for a best-of-three match, this is games won (0-2), not points
  score2        Int?
  winnerId      String?
  round         String // e.g. "LEAGUE", "SEMI_FINAL_1", "SEMI_FINAL_2", "FINAL"
  status        String    @default("PENDING") // MatchStatus: PENDING | COMPLETED | VOID
  matchOrder    Int
  completedAt   DateTime? // set once, the first time status becomes COMPLETED; used for leaderboard bucketing
  isBestOfThree Boolean   @default(false) // knockout-round option; league matches are always single-game
  game1Score1   Int?
  game1Score2   Int?
  game2Score1   Int?
  game2Score2   Int?
  game3Score1   Int?
  game3Score2   Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    Player     @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: Cascade)
  player2    Player?    @relation("Player2Matches", fields: [player2Id], references: [id], onDelete: Cascade)
  winner     Player?    @relation("MatchWinner", fields: [winnerId], references: [id])

  @@index([tournamentId])
}

/**
 * Something the group paid for together — court booking, shuttles, food —
 * logged by the organizer against one player who fronted the money.
 * Each participant's exact share lives on ExpenseParticipant, whether it
 * came from an even split or was typed in by hand; settlement math only
 * ever reads shareAmount, never re-derives it.
 */
model Expense {
  id             String   @id @default(cuid())
  tournamentId   String
  description    String
  amount         Int // total, in whole rupees
  splitMode      String   @default("EQUAL") // "EQUAL" | "CUSTOM" -- display only, not used in settlement math
  paidByPlayerId String
  createdAt      DateTime @default(now())

  tournament   Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  paidBy       Player               @relation("ExpensePaidBy", fields: [paidByPlayerId], references: [id], onDelete: Cascade)
  participants ExpenseParticipant[]

  @@index([tournamentId])
}

model ExpenseParticipant {
  id          String @id @default(cuid())
  expenseId   String
  playerId    String
  shareAmount Int // this participant's portion of the expense, in rupees

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  player  Player  @relation("ExpenseParticipant", fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([expenseId, playerId])
  @@index([playerId])
}

/**
 * A group of players sharing one community leaderboard — e.g. a club or a
 * regular Sunday-morning group. Public and browsable; anyone signed in can
 * request to join, and an admin approves. A player can belong to (and admin)
 * more than one community.
 */
model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  memberships CommunityMembership[]

  @@index([name])
}

/**
 * One player's membership in one community — the join row that carries both
 * the request/approval lifecycle (status) and the admin/member distinction
 * (role). A brand-new community's creator gets an ADMIN + APPROVED row here
 * immediately, so there's always at least one admin who can approve others.
 */
model CommunityMembership {
  id          String   @id @default(cuid())
  communityId String
  profileId   String
  role        String   @default("MEMBER") // CommunityRole: ADMIN | MEMBER
  status      String   @default("PENDING") // CommunityMembershipStatus: PENDING | APPROVED
  createdAt   DateTime @default(now())

  community Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([communityId, profileId])
  @@index([communityId])
  @@index([profileId])
}

model NewsItem {
  id          String   @id @default(cuid())
  title       String
  summary     String // short excerpt from the source API, not full article text
  url         String   @unique // dedupe key across ingestion runs; also the "Read more" link
  sourceName  String
  imageUrl    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
